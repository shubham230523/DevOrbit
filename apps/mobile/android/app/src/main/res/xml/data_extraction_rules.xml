<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules): cloud backup and device-to-device transfer.

  Paired session credentials are bound to this device's Android Keystore and must never be
  transferred or restored elsewhere; excluding them prevents silent credential sharing between
  devices and avoids shipping unusable ciphertext.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="devorbit_secure" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="devorbit_secure" />
    </device-transfer>
</data-extraction-rules>
