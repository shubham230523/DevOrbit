# DevOrbit production environment template.
# Copy to `infrastructure/deployment/.env` (git-ignored: *.env) and fill in real values.
# NEVER commit populated values.

# --- Reverse proxy (Caddy) ----------------------------------------------------------------------
CADDY_EMAIL=ops@example.com
BROKER_HOST=broker.example.com
HOST_BRIDGE_HOST=host.example.com

# --- Connection Broker -------------------------------------------------------------------------
DEVORBIT_ENV=production
DEVORBIT_BROKER_PORT=8081
# Service-to-service admin secret. >= 32 chars, generated with a CSPRNG:
#   openssl rand -base64 48
DEVORBIT_BROKER_SECRET=__GENERATE_AND_STORE_IN_A_SECRET_MANAGER__

# --- Host Bridge (runs on the developer's own machine) ------------------------------------------
# DEVORBIT_PORT=8082
# Loopback-only bind when a reverse proxy fronts the bridge.
# DEVORBIT_BIND_ADDR=127.0.0.1
# Public HTTPS URL advertised in the pairing QR payload (must be https:// in production).
# DEVORBIT_ADVERTISED_URL=https://host.example.com
# Trusted proxy addresses allowed to assert X-Forwarded-Proto (127.0.0.1 = local Caddy).
# DEVORBIT_TRUSTED_PROXIES=127.0.0.1
# Broker endpoints (https + wss in production).
# DEVORBIT_BROKER_HTTP_URL=https://broker.example.com
# DEVORBIT_BROKER_WS_URL=wss://broker.example.com
# Host secret (>= 16 chars, per host, stored in a secret manager).
# DEVORBIT_HOST_SECRET=__PER_HOST_SECRET__
# Optional native TLS instead of a reverse proxy:
# DEVORBIT_TLS_CERT_FILE=/etc/devorbit/tls/fullchain.pem
# DEVORBIT_TLS_KEY_FILE=/etc/devorbit/tls/privkey.pem
# AI provider (host-side only; never shipped to clients).
# DEVORBIT_GEMINI_API_KEY=__HOST_OPERATOR_KEY__
# DEVORBIT_GEMINI_MODEL=gemini-2.5-flash
