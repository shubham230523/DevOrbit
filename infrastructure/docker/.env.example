# Copy to `infrastructure/docker/.env` (git-ignored via *.env) for local development.
# NEVER commit populated values.

# Service-to-service admin secret used by the Host Bridge to authorize/revoke sessions and to read
# /metrics. Generate with: openssl rand -base64 48
DEVORBIT_BROKER_SECRET=

# development | production
DEVORBIT_ENV=development

# Only required when starting the optional future-db profile:
# POSTGRES_PASSWORD=
# POSTGRES_USER=devorbit
# POSTGRES_DB=devorbit_db
