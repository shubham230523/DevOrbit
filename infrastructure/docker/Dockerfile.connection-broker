FROM golang:1.24-alpine AS builder

WORKDIR /app

COPY services/connection-broker/ ./
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -o connection-broker ./cmd/connection-broker

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/connection-broker .
EXPOSE 8081
CMD ["./connection-broker"]
